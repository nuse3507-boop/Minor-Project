# PostgreSQL is required for the application. Never put real credentials in this template.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Explicit isolated automated tests alone may use SQLite with ENVIRONMENT=test.
ENVIRONMENT=development
SECURE_COOKIES=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_URL=http://localhost:5173
STORAGE_PATH=private-data
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production requires a stable secret key, shared by API and worker. Never commit it.
STORAGE_KEY=
MAX_UPLOAD_BYTES=20971520
MAX_PAGES=150
MAX_DOCUMENT_TOKENS=100000
# Set only provider/model pairs you are authorized to use. No model availability is assumed.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional current USD price estimates. No defaults or free-tier claims are assumed.
# PROVIDER_PRICING={"gemini":{"input_price_per_million":0.0,"output_price_per_million":0.0}}
# Registration requires email delivery in production; development verifies locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
